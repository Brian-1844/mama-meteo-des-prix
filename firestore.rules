rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateur : son identifiant (UID) a une fiche dans la collection « admins ».
    function estAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Un compte réel (e-mail), pas un visiteur anonyme.
    function estCompte() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Le commerce existe, n'est pas suspendu, et son abonnement est en cours.
    function commerceValide(uid) {
      let c = get(/databases/$(database)/documents/commerces/$(uid)).data;
      return c.actif == true && c.abonnement > request.time;
    }

    // Les 4 emplacements d'un commerce : <uid>_1 à <uid>_4.
    function emplacementDe(id, uid) {
      return id in [uid + '_1', uid + '_2', uid + '_3', uid + '_4'];
    }

    // Contenu d'une annonce : champs, tailles, 62 jours au plus.
    // Une « promo » a un prix normal et un prix promo plus bas ;
    // un « arrivage » n'a pas de prix normal et son prix est facultatif.
    function annonceValide() {
      let p = request.resource.data;
      let base = p.keys().hasOnly(['commerce', 'produit', 'type', 'prixNormal', 'prixPromo', 'fin', 'cree', 'photo', 'epuisement'])
        && p.keys().hasAll(['commerce', 'produit', 'type', 'fin', 'cree'])
        && p.produit is string && p.produit.size() > 0 && p.produit.size() <= 60
        && p.type in ['promo', 'arrivage']
        && p.fin is timestamp && p.fin > request.time
        && p.fin < request.time + duration.value(62, 'd')
        && p.cree == request.time
        && (!('photo' in p) || p.photo is bool)
        && (!('epuisement' in p) || p.epuisement is bool);
      let promo = p.type == 'promo'
        && p.prixNormal is int && p.prixPromo is int
        && p.prixPromo > 0 && p.prixPromo < p.prixNormal && p.prixNormal <= 99999999;
      let arrivage = p.type == 'arrivage'
        && !('prixNormal' in p)
        && (!('prixPromo' in p) || (p.prixPromo is int && p.prixPromo > 0 && p.prixPromo <= 99999999));
      return base && (promo || arrivage);
    }

    // Les fiches admin ne se créent que depuis la console Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Commerces : tout le monde lit, seul l'administrateur écrit.
    match /commerces/{uid} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Annonces (promos et arrivages) : 4 emplacements par commerce.
    match /promos/{id} {
      allow read: if true;
      allow create, update: if estCompte()
        && emplacementDe(id, request.auth.uid)
        && request.resource.data.commerce == request.auth.uid
        && commerceValide(request.auth.uid)
        && annonceValide();
      allow delete: if estAdmin()
        || (estCompte() && resource.data.commerce == request.auth.uid);
    }

    // Photos : une par annonce, même identifiant. Petite image JPEG en texte.
    match /photos/{id} {
      allow read: if true;
      allow create, update: if estCompte()
        && emplacementDe(id, request.auth.uid)
        && request.resource.data.keys().hasOnly(['commerce', 'image', 'cree'])
        && request.resource.data.keys().hasAll(['commerce', 'image', 'cree'])
        && request.resource.data.commerce == request.auth.uid
        && request.resource.data.image is string
        && request.resource.data.image.size() > 23
        && request.resource.data.image.size() <= 200000
        && request.resource.data.image[0:23] == 'data:image/jpeg;base64,'
        && request.resource.data.cree == request.time
        && commerceValide(request.auth.uid);
      allow delete: if estAdmin()
        || (estCompte() && resource.data.commerce == request.auth.uid);
    }

    // Signalements : un par appareil (connexion anonyme) et par annonce,
    // l'identifiant étant <annonce>_<uid>. Seul l'administrateur les lit et les supprime.
    match /signalements/{id} {
      allow create: if request.auth != null
        && id == request.resource.data.promo + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['promo', 'commerce', 'produit', 'motif', 'cree'])
        && request.resource.data.keys().hasAll(['promo', 'commerce', 'produit', 'motif', 'cree'])
        && request.resource.data.promo is string && request.resource.data.promo.size() <= 80
        && request.resource.data.commerce is string && request.resource.data.commerce.size() <= 60
        && request.resource.data.produit is string && request.resource.data.produit.size() <= 60
        && request.resource.data.motif is string && request.resource.data.motif.size() <= 60
        && request.resource.data.cree == request.time;
      allow read, delete: if estAdmin();
    }
  }
}
